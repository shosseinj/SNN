{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run VGG Example",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/myvenv/Scripts/python.exe",
            "args": [
                "--model_type=ReLU",
                "--model_name=VGG_BN_example",
                "--data_name=CIFAR10",
                "--load=weights_epoch_11.weights.h5",
                "--save=True",
                "--epochs=0"
            ],
            "console": "integratedTerminal",
        }
    ]
}


